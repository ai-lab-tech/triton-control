{
  "$defs": {
    "EngineeringAttempt": {
      "additionalProperties": false,
      "properties": {
        "input_inventory": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Input Inventory",
          "type": "string"
        },
        "operation": {
          "enum": [
            "packaging",
            "conversion",
            "optimization",
            "validation"
          ],
          "title": "Operation",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "output_inventory": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Output Inventory",
          "type": "string"
        },
        "tool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool"
        }
      },
      "required": [
        "origin",
        "operation",
        "input_inventory",
        "output_inventory"
      ],
      "title": "EngineeringAttempt",
      "type": "object"
    },
    "FileEntry": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "size",
        "digest"
      ],
      "title": "FileEntry",
      "type": "object"
    },
    "InventoryV1": {
      "additionalProperties": false,
      "properties": {
        "files": {
          "items": {
            "$ref": "#/$defs/FileEntry"
          },
          "title": "Files",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "files"
      ],
      "title": "InventoryV1",
      "type": "object"
    },
    "Origin": {
      "additionalProperties": false,
      "properties": {
        "installation_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Installation Id",
          "type": "string"
        },
        "record_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        }
      },
      "required": [
        "installation_id",
        "record_id"
      ],
      "title": "Origin",
      "type": "object"
    },
    "PluginReference": {
      "additionalProperties": false,
      "properties": {
        "installation_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Installation Id",
          "type": "string"
        },
        "provider": {
          "enum": [
            "mlflow",
            "hf",
            "generator"
          ],
          "title": "Provider",
          "type": "string"
        },
        "record_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "installation_id",
        "record_id"
      ],
      "title": "PluginReference",
      "type": "object"
    },
    "Snapshot": {
      "additionalProperties": false,
      "properties": {
        "inventory": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Inventory",
          "type": "string"
        },
        "kind": {
          "enum": [
            "manual",
            "git",
            "hf",
            "mlflow"
          ],
          "title": "Kind",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        }
      },
      "required": [
        "origin",
        "kind",
        "inventory"
      ],
      "title": "Snapshot",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EngineeringAttempt"
      },
      "maxItems": 64,
      "title": "Attempts",
      "type": "array"
    },
    "candidate_origin": {
      "$ref": "#/$defs/Origin"
    },
    "capture_origin": {
      "$ref": "#/$defs/Origin"
    },
    "expected_backends": {
      "additionalProperties": {
        "type": "string"
      },
      "maxProperties": 100,
      "title": "Expected Backends",
      "type": "object"
    },
    "expected_task_revision": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Task Revision"
    },
    "manual_source_origin": {
      "anyOf": [
        {
          "$ref": "#/$defs/Origin"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "missing_evaluation_inputs": {
      "default": [
        "evaluation_dataset",
        "expected_results",
        "acceptance_thresholds"
      ],
      "items": {
        "maxLength": 80,
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9_]*$",
        "type": "string"
      },
      "maxItems": 50,
      "title": "Missing Evaluation Inputs",
      "type": "array"
    },
    "plugin_references": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PluginReference"
      },
      "maxItems": 32,
      "title": "Plugin References",
      "type": "array"
    },
    "previous_serving_candidate": {
      "anyOf": [
        {
          "$ref": "#/$defs/Origin"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "prior_inventories": {
      "default": [],
      "items": {
        "$ref": "#/$defs/InventoryV1"
      },
      "maxItems": 65,
      "title": "Prior Inventories",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/Snapshot"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "task_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Id"
    },
    "triton_version": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Triton Version",
      "type": "string"
    }
  },
  "required": [
    "candidate_origin",
    "capture_origin",
    "triton_version"
  ],
  "title": "PreparedImportRequest",
  "type": "object"
}
