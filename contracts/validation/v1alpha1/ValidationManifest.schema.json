{
  "$defs": {
    "Criterion": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "correctness",
            "performance"
          ],
          "title": "Category",
          "type": "string"
        },
        "metric": {
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
          "title": "Metric",
          "type": "string"
        },
        "operator": {
          "enum": [
            "gte",
            "lte",
            "eq"
          ],
          "title": "Operator",
          "type": "string"
        },
        "threshold": {
          "maxLength": 80,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Threshold",
          "type": "string"
        },
        "unit": {
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "metric",
        "category",
        "unit",
        "operator",
        "threshold"
      ],
      "title": "Criterion",
      "type": "object"
    },
    "EvaluatorIdentity": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/Reference"
        },
        "image": {
          "maxLength": 512,
          "pattern": "^[a-z0-9][a-z0-9.:-]*(/[a-z0-9][a-z0-9._-]*)+@sha256:[0-9a-f]{64}$",
          "title": "Image",
          "type": "string"
        },
        "name": {
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "image",
        "code"
      ],
      "title": "EvaluatorIdentity",
      "type": "object"
    },
    "HardwareRuntime": {
      "additionalProperties": false,
      "description": "Exact supported profiles in v1alpha1; no inferred GPU/driver compatibility.",
      "properties": {
        "architecture": {
          "enum": [
            "amd64",
            "arm64"
          ],
          "title": "Architecture",
          "type": "string"
        },
        "cpuModel": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$",
          "title": "Cpumodel",
          "type": "string"
        },
        "cudaVersion": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cudaversion"
        },
        "driverVersion": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Driverversion"
        },
        "gpuCount": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Gpucount",
          "type": "integer"
        },
        "gpuModel": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gpumodel"
        },
        "operatingSystem": {
          "const": "linux",
          "title": "Operatingsystem",
          "type": "string"
        },
        "tritonVersion": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$",
          "title": "Tritonversion",
          "type": "string"
        }
      },
      "required": [
        "architecture",
        "operatingSystem",
        "cpuModel",
        "gpuCount",
        "tritonVersion"
      ],
      "title": "HardwareRuntime",
      "type": "object"
    },
    "Quantities": {
      "additionalProperties": false,
      "properties": {
        "cpu": {
          "maxLength": 20,
          "pattern": "^((0|[1-9][0-9]*)(\\.[0-9]{1,3})?|[1-9][0-9]*m)$",
          "title": "Cpu",
          "type": "string"
        },
        "memory": {
          "maxLength": 24,
          "pattern": "^[1-9][0-9]*(Ki|Mi|Gi|Ti|k|M|G|T)?$",
          "title": "Memory",
          "type": "string"
        }
      },
      "required": [
        "cpu",
        "memory"
      ],
      "title": "Quantities",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "uri": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "pattern": "^(s3|https)://[A-Za-z0-9][A-Za-z0-9./:_-]*$",
              "type": "string"
            },
            {
              "maxLength": 1024,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$",
              "type": "string"
            }
          ],
          "title": "Uri"
        }
      },
      "required": [
        "uri",
        "digest"
      ],
      "title": "Reference",
      "type": "object"
    },
    "Repository": {
      "additionalProperties": false,
      "properties": {
        "inventoryDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Inventorydigest",
          "type": "string"
        },
        "materializerImage": {
          "anyOf": [
            {
              "maxLength": 512,
              "pattern": "^[a-z0-9][a-z0-9.:-]*(/[a-z0-9][a-z0-9._-]*)+@sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Materializerimage"
        },
        "preparedInventoryDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Preparedinventorydigest",
          "type": "string"
        },
        "uri": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "^(s3|https)://[A-Za-z0-9][A-Za-z0-9./:_-]*$",
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "inventoryDigest",
        "preparedInventoryDigest"
      ],
      "title": "Repository",
      "type": "object"
    },
    "Resources": {
      "additionalProperties": false,
      "properties": {
        "gpuCount": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Gpucount",
          "type": "integer"
        },
        "limits": {
          "$ref": "#/$defs/Quantities"
        },
        "requests": {
          "$ref": "#/$defs/Quantities"
        }
      },
      "required": [
        "requests",
        "limits",
        "gpuCount"
      ],
      "title": "Resources",
      "type": "object"
    },
    "StartupConfiguration": {
      "additionalProperties": false,
      "properties": {
        "configuration": {
          "$ref": "#/$defs/Reference"
        },
        "models": {
          "items": {
            "$ref": "#/$defs/StartupModel"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Models",
          "type": "array"
        },
        "resourcesPerReplica": {
          "$ref": "#/$defs/Resources"
        }
      },
      "required": [
        "models",
        "configuration",
        "resourcesPerReplica"
      ],
      "title": "StartupConfiguration",
      "type": "object"
    },
    "StartupModel": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Name",
          "type": "string"
        },
        "versions": {
          "items": {
            "maxLength": 19,
            "pattern": "^[1-9][0-9]*$",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Versions",
          "type": "array"
        }
      },
      "required": [
        "name",
        "versions"
      ],
      "title": "StartupModel",
      "type": "object"
    }
  },
  "$id": "urn:triton-control:validation:v1alpha1:ValidationManifest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "validation.triton-control/v1alpha1",
      "title": "Apiversion",
      "type": "string"
    },
    "criteria": {
      "items": {
        "$ref": "#/$defs/Criterion"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Criteria",
      "type": "array"
    },
    "dataset": {
      "$ref": "#/$defs/Reference"
    },
    "evaluator": {
      "$ref": "#/$defs/EvaluatorIdentity"
    },
    "expectedOutputs": {
      "$ref": "#/$defs/Reference"
    },
    "image": {
      "maxLength": 512,
      "pattern": "^[a-z0-9][a-z0-9.:-]*(/[a-z0-9][a-z0-9._-]*)+@sha256:[0-9a-f]{64}$",
      "title": "Image",
      "type": "string"
    },
    "kind": {
      "const": "ValidationManifest",
      "title": "Kind",
      "type": "string"
    },
    "performanceScope": {
      "const": "single-replica",
      "default": "single-replica",
      "title": "Performancescope",
      "type": "string"
    },
    "repository": {
      "$ref": "#/$defs/Repository"
    },
    "sourceCode": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reference"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "startup": {
      "$ref": "#/$defs/StartupConfiguration"
    },
    "supportedTargets": {
      "items": {
        "$ref": "#/$defs/HardwareRuntime"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Supportedtargets",
      "type": "array"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "image",
    "repository",
    "dataset",
    "expectedOutputs",
    "evaluator",
    "criteria",
    "startup",
    "supportedTargets"
  ],
  "title": "ValidationManifest",
  "type": "object"
}
