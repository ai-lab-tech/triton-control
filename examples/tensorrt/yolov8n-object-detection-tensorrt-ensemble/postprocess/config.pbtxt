name: "postprocess"
backend: "python"
max_batch_size: 0

input [
  {
    name: "RAW_DETECTIONS"
    data_type: TYPE_FP32
    dims: [ 1, 84, 8400 ]
  }
]

output [
  {
    name: "BOXES"
    data_type: TYPE_FP32
    dims: [ -1, 4 ]
  },
  {
    name: "SCORES"
    data_type: TYPE_FP32
    dims: [ -1 ]
  },
  {
    name: "CLASS_IDS"
    data_type: TYPE_INT64
    dims: [ -1 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_CPU
  }
]
