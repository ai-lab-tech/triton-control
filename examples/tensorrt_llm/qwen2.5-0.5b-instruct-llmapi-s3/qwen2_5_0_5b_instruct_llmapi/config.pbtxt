name: "qwen2_5_0_5b_instruct_llmapi"
backend: "python"
max_batch_size: 0

input [
  {
    name: "text_input"
    data_type: TYPE_STRING
    dims: [ 1 ]
  }
]

output [
  {
    name: "text_output"
    data_type: TYPE_STRING
    dims: [ 1 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
  }
]

parameters: {
  key: "hf_model_dir"
  value: { string_value: "model" }
}

parameters: {
  key: "max_tokens"
  value: { string_value: "128" }
}

parameters: {
  key: "temperature"
  value: { string_value: "0.2" }
}

parameters: {
  key: "top_p"
  value: { string_value: "0.95" }
}
