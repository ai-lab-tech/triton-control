name: "iris_classifier"
backend: "python"
max_batch_size: 16

input [
  {
    name: "FEATURES"
    data_type: TYPE_FP32
    dims: [ 4 ]
  }
]

output [
  {
    name: "CLASS_ID"
    data_type: TYPE_INT64
    dims: [ 1 ]
  },
  {
    name: "PROBABILITIES"
    data_type: TYPE_FP32
    dims: [ 3 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_CPU
  }
]

