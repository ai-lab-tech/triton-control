{
  "name": "triton-control-deploy",
  "displayName": "Triton Control Deploy",
  "description": "Browse S3 profiles and upload workspace files and folders with drag and drop; deploy Triton model repositories.",
  "version": "0.4.8",
  "publisher": "triton-control",
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:tritonControl.deployModelRepository",
    "onCommand:tritonControl.uploadModelRepositorySimple",
    "onCommand:tritonControl.newModelRepository",
    "onCommand:tritonControl.openRepositorySetup",
    "onCommand:tritonControl.revealRepository",
    "onCommand:tritonControl.refreshRepositories",
    "onView:tritonControl.workspaceActions",
    "onStartupFinished",
    "onFileSystem:triton-s3"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tritonControl.deployModelRepository",
        "title": "Triton Control: Deploy Model Repository"
      },
      {
        "command": "tritonControl.uploadModelRepositorySimple",
        "title": "Triton Control: Upload Model Repository (Simple Wizard)"
      },
      {
        "command": "tritonControl.newModelRepository",
        "title": "Triton Control: New Model Repository",
        "icon": "$(new-folder)"
      },
      {
        "command": "tritonControl.openRepositorySetup",
        "title": "Triton Control: Open Repository Setup",
        "icon": "$(book)"
      },
      {
        "command": "tritonControl.revealRepository",
        "title": "Triton Control: Reveal Repository",
        "icon": "$(folder-opened)"
      },
      {
        "command": "tritonControl.refreshRepositories",
        "title": "Triton Control: Refresh Repositories",
        "icon": "$(refresh)"
      },
      {
        "command": "tritonControl.connectS3",
        "title": "Choose Profile\u2026",
        "icon": "$(plug)",
        "category": "S3"
      },
      {
        "command": "tritonControl.refreshS3",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "S3"
      },
      {
        "command": "tritonControl.uploadS3",
        "title": "Upload\u2026",
        "icon": "$(cloud-upload)",
        "category": "S3"
      },
      {
        "command": "tritonControl.moreS3",
        "title": "Triton Control: Load More S3 Objects",
        "icon": "$(more)"
      },
      {
        "command": "tritonControl.disconnectS3",
        "title": "Disconnect",
        "icon": "$(debug-disconnect)",
        "category": "S3"
      },
      {
        "command": "tritonControl.deleteS3",
        "title": "Triton Control: Delete S3 Object or Folder",
        "icon": "$(trash)"
      },
      {
        "command": "tritonControl.copyS3",
        "title": "Copy",
        "icon": "$(copy)",
        "category": "S3"
      },
      {
        "command": "tritonControl.cutS3",
        "title": "Cut",
        "icon": "$(scissors)",
        "category": "S3"
      },
      {
        "command": "tritonControl.pasteS3",
        "title": "Paste",
        "icon": "$(clippy)",
        "category": "S3"
      },
      {
        "command": "tritonControl.downloadS3",
        "title": "Download\u2026",
        "icon": "$(cloud-download)",
        "category": "S3"
      },
      {
        "command": "tritonControl.switchS3Profile",
        "title": "Switch Profile\u2026",
        "category": "S3",
        "icon": "$(plug)"
      },
      {
        "command": "tritonControl.uploadWorkspaceS3",
        "title": "Upload to Bucket Root\u2026",
        "category": "S3",
        "icon": "$(cloud-upload)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tritonControl",
          "title": "Triton Control",
          "icon": "resources/triton-control.svg"
        }
      ]
    },
    "views": {
      "tritonControl": [
        {
          "id": "tritonControl.workspaceActions",
          "name": "Workspace"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "tritonControl.newModelRepository",
          "when": "view == workbench.explorer.fileView || view == tritonControl.workspaceActions",
          "group": "navigation@89"
        },
        {
          "command": "tritonControl.refreshRepositories",
          "when": "view == tritonControl.workspaceActions",
          "group": "navigation@90"
        },
        {
          "command": "tritonControl.connectS3",
          "when": "view == workbench.explorer.fileView && !tritonControl.s3Connected",
          "group": "navigation@81"
        },
        {
          "command": "tritonControl.disconnectS3",
          "when": "view == workbench.explorer.fileView && tritonControl.s3Connected",
          "group": "navigation@82"
        },
        {
          "command": "tritonControl.refreshS3",
          "when": "view == workbench.explorer.fileView && tritonControl.s3Connected",
          "group": "navigation@83"
        },
        {
          "command": "tritonControl.switchS3Profile",
          "when": "view == workbench.explorer.fileView && tritonControl.s3Connected",
          "group": "navigation@81"
        }
      ],
      "explorer/context": [
        {
          "command": "tritonControl.deployModelRepository",
          "when": "explorerResourceIsFolder && resourceScheme != triton-s3",
          "group": "navigation@90"
        },
        {
          "command": "tritonControl.uploadModelRepositorySimple",
          "when": "explorerResourceIsFolder && resourceScheme != triton-s3",
          "group": "navigation@91"
        },
        {
          "command": "tritonControl.newModelRepository",
          "when": "explorerResourceIsFolder && resourceScheme != triton-s3",
          "group": "navigation@89"
        },
        {
          "submenu": "tritonControl.s3Operations",
          "when": "resourceScheme == file || resourceScheme == vscode-remote || resourceScheme == triton-s3",
          "group": "tritonS3@1"
        }
      ],
      "view/item/context": [
        {
          "command": "tritonControl.openRepositorySetup",
          "when": "view == tritonControl.workspaceActions && viewItem == tritonModelRepositoryPending",
          "group": "navigation@80"
        },
        {
          "command": "tritonControl.openRepositorySetup",
          "when": "view == tritonControl.workspaceActions && viewItem == tritonModelRepositoryReady",
          "group": "navigation@80"
        },
        {
          "command": "tritonControl.deployModelRepository",
          "when": "view == tritonControl.workspaceActions && viewItem == tritonModelRepositoryReady",
          "group": "navigation@90"
        }
      ],
      "tritonControl.s3Operations": [
        {
          "command": "tritonControl.uploadS3",
          "when": "resourceScheme == triton-s3",
          "group": "2_transfer@1"
        },
        {
          "command": "tritonControl.downloadS3",
          "when": "resourceScheme == triton-s3",
          "group": "2_transfer@2"
        },
        {
          "command": "tritonControl.copyS3",
          "when": "resourceScheme == file || resourceScheme == vscode-remote || resourceScheme == triton-s3",
          "group": "3_clipboard@1"
        },
        {
          "command": "tritonControl.cutS3",
          "when": "resourceScheme == triton-s3",
          "group": "3_clipboard@2"
        },
        {
          "command": "tritonControl.pasteS3",
          "when": "resourceScheme == triton-s3",
          "group": "3_clipboard@3"
        },
        {
          "command": "tritonControl.connectS3",
          "group": "1_connection@1",
          "when": "!tritonControl.s3Connected"
        },
        {
          "command": "tritonControl.disconnectS3",
          "when": "tritonControl.s3Connected",
          "group": "1_connection@2"
        },
        {
          "command": "tritonControl.refreshS3",
          "when": "tritonControl.s3Connected",
          "group": "1_connection@1"
        },
        {
          "command": "tritonControl.switchS3Profile",
          "when": "tritonControl.s3Connected",
          "group": "4_profile@1"
        },
        {
          "command": "tritonControl.uploadWorkspaceS3",
          "when": "tritonControl.s3Connected && (resourceScheme == file || resourceScheme == vscode-remote)",
          "group": "2_transfer@1"
        }
      ]
    },
    "configuration": {
      "title": "Triton Control Deploy",
      "properties": {
        "tritonControlDeploy.s3Endpoint": {
          "type": "string",
          "default": "",
          "description": "S3-compatible endpoint URL."
        },
        "tritonControlDeploy.s3Bucket": {
          "type": "string",
          "default": "",
          "description": "Target S3 bucket for uploaded Triton model repositories."
        },
        "tritonControlDeploy.s3Prefix": {
          "type": "string",
          "default": "",
          "description": "Optional repository parent prefix. The deployment name is appended below this prefix."
        },
        "tritonControlDeploy.s3Region": {
          "type": "string",
          "default": "us-east-1",
          "description": "S3 region."
        },
        "tritonControlDeploy.s3AccessKeyId": {
          "type": "string",
          "default": "",
          "description": "S3 access key. Falls back to AWS_ACCESS_KEY_ID."
        },
        "tritonControlDeploy.s3SecretAccessKey": {
          "type": "string",
          "default": "",
          "description": "S3 secret key. Falls back to AWS_SECRET_ACCESS_KEY."
        },
        "tritonControlDeploy.s3ForcePathStyle": {
          "type": "boolean",
          "default": true,
          "description": "Use path-style S3 requests. Keep enabled for many S3-compatible providers and custom endpoints."
        },
        "tritonControlDeploy.s3CaCertificate": {
          "type": "string",
          "default": "",
          "description": "Optional PEM CA certificate passed to Triton deployments for HTTPS S3 endpoints."
        }
      }
    },
    "keybindings": [],
    "submenus": [
      {
        "id": "tritonControl.s3Operations",
        "label": "S3 Operations"
      }
    ]
  },
  "devDependencies": {
    "@vscode/vsce": "^2.15.0"
  },
  "scripts": {
    "test": "node --test",
    "package": "vsce package"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "S3 access requires a trusted workspace."
    }
  },
  "enabledApiProposals": [
    "fsChunks"
  ]
}
